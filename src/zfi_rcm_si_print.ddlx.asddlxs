@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'RCM Self Invoice',
  typeNamePlural: 'RCM Self Invoices',

  title: {
    type: #STANDARD,
    value: 'InvoiceNumber'
  },

  description: {
    type: #STANDARD,
    value: 'SupplierName'
  }
}

@UI.presentationVariant: [ {
  qualifier: 'Default',
  maxItems: 20,

  sortOrder: [
    {
      by: 'InvoiceDate',
      direction: #DESC
    }
  ],

  visualizations: [
    {
      type: #AS_LINEITEM
    }
  ]
} ]

